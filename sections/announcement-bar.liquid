{%- liquid
  assign section_id = section.id
  assign blocks_size = section.blocks.size
  assign color_scheme = section.settings.color_scheme | default: 'scheme-2'
-%}

{%- if blocks_size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section_id }} {
      display: block;
      width: 100%;
    }
    #shopify-section-{{ section_id }} > * {
      grid-column: 1 / -1;
      width: 100%;
    }
    #AnnouncementBar-{{ section_id }} {
      --announcement-pv: {{ section.settings.padding_vertical | default: 10 }}px;
      {%- if section.settings.custom_bg_color != blank -%}
        background-color: {{ section.settings.custom_bg_color }};
      {%- endif -%}
      {%- if section.settings.custom_text_color != blank -%}
        color: {{ section.settings.custom_text_color }};
      {%- endif -%}
    }
  {%- endstyle -%}

  <announcement-bar
    id="AnnouncementBar-{{ section_id }}"
    class="announcement-bar full-width color-{{ color_scheme }}{% if section.settings.font_size == 'medium' %} announcement-bar--medium{% endif %}{% if section.settings.enable_marquee %} announcement-bar--marquee{% endif %}"
    role="region"
    aria-label="Announcement"
    data-announcement-bar
    data-autoplay="{{ section.settings.enable_autoplay }}"
    data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
    data-marquee="{{ section.settings.enable_marquee }}"
    data-total="{{ blocks_size }}"
  >
    <div class="announcement-bar__inner">
      {%- if section.settings.enable_marquee -%}
        <div class="announcement-bar__marquee-track" data-marquee-track>
          {%- for i in (1..3) -%}
            <div class="announcement-bar__marquee-group" aria-hidden="{% if i > 1 %}true{% else %}false{% endif %}">
              {%- for block in section.blocks -%}
                <div class="announcement-bar__item announcement-bar__item--marquee" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="announcement-bar__link">
                  {%- else -%}
                    <span class="announcement-bar__content">
                  {%- endif -%}

                    {%- if block.settings.icon != 'none' and block.settings.icon != blank -%}
                      <span class="announcement-bar__icon" aria-hidden="true">
                        {% render 'icon', icon: block.settings.icon, width: 14, height: 14 %}
                      </span>
                    {%- endif -%}

                    {%- if block.settings.badge_text != blank -%}
                      <span class="announcement-bar__badge">{{ block.settings.badge_text }}</span>
                    {%- endif -%}

                    <span class="announcement-bar__text">{{ block.settings.text }}</span>

                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- else -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="announcement-bar__slider-wrapper text-{{ section.settings.text_alignment }}">
          {%- if blocks_size > 1 and section.settings.show_arrows -%}
            <button
              type="button"
              class="announcement-bar__arrow announcement-bar__arrow--prev"
              aria-label="Previous announcement"
              data-announcement-prev
            >
              {% render 'icon', icon: 'chevron-left', width: 14, height: 14 %}
            </button>
          {%- endif -%}

          <div class="announcement-bar__items" data-announcement-items>
            {%- for block in section.blocks -%}
              <div
                class="announcement-bar__item{% if forloop.first %} is-active{% endif %}"
                data-announcement-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link">
                {%- else -%}
                  <div class="announcement-bar__content">
                {%- endif -%}

                  {%- if block.settings.icon != 'none' and block.settings.icon != blank -%}
                    <span class="announcement-bar__icon" aria-hidden="true">
                      {% render 'icon', icon: block.settings.icon, width: 14, height: 14 %}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.badge_text != blank -%}
                    <span class="announcement-bar__badge">{{ block.settings.badge_text }}</span>
                  {%- endif -%}

                  <span class="announcement-bar__text">{{ block.settings.text }}</span>

                  {%- if block.settings.link != blank -%}
                    <span class="announcement-bar__link-arrow" aria-hidden="true">
                      {% render 'icon', icon: 'arrow-right', width: 12, height: 12 %}
                    </span>
                  {%- endif -%}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if blocks_size > 1 and section.settings.show_arrows -%}
            <button
              type="button"
              class="announcement-bar__arrow announcement-bar__arrow--next"
              aria-label="Next announcement"
              data-announcement-next
            >
              {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_close_button -%}
        <button
          type="button"
          class="announcement-bar__close"
          aria-label="Dismiss announcement"
          data-announcement-close
        >
          {% render 'icon', icon: 'close', width: 14, height: 14 %}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1 (Dark)"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2 (Light)"
        }
      ],
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom background color",
      "info": "Optional custom background color overriding the color scheme."
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom text color",
      "info": "Optional custom text color overriding the color scheme."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Font size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Carousel & Marquee"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Change slide every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable continuous ticker (Marquee)",
      "default": false,
      "info": "Continuously scrolls announcements in a single marquee line."
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Allow customer to dismiss",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store! Free shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "Optional short badge pill, e.g. 'NEW', 'SALE'"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "shipping",
              "label": "Shipping / Truck"
            },
            {
              "value": "tag",
              "label": "Tag / Sale"
            },
            {
              "value": "sparkle",
              "label": "Sparkle / Star"
            },
            {
              "value": "gift",
              "label": "Gift box"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "check",
              "label": "Checkmark"
            },
            {
              "value": "bell",
              "label": "Bell"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "✨ Free worldwide shipping on all orders over $75",
            "icon": "shipping",
            "badge_text": "FREE SHIPPING"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New season arrivals are here — Explore the collection",
            "icon": "sparkle",
            "badge_text": "NEW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
