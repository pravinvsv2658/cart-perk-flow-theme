          "default": false
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "vendor"
      },
      {
        "type": "title"
      },
      {
        "type": "price"
      },
      {
        "type": "inventory_threshold"
      },
      {
        "type": "variants"
      },
      {
        "type": "quantity_selector"
      },
      {
        "type": "buy_buttons"
      },
      {
        "type": "trust_grid"
      },
      {
        "type": "description"
      },
      {
        "type": "custom_information"
      },
      {
        "type": "share"
      }
