          "default": true
        }
      ]
    },
    {
      "type": "custom_information",
      "name": "Custom Information",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Guarantee"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
