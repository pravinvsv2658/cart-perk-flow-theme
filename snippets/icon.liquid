{% doc %}
  Centralized SVG Icon Library snippet.
  Renders SVG icons throughout the theme.

  @param {string} icon - The icon name to render: 'tag', 'edit', 'chevron', 'trash', 'close', 'lock', 'bag', 'cart', 'account', 'arrow-left', 'arrow-right', 'package', 'return', 'check', 'warning', 'search', 'eye'
  @param {string} [class] - Optional CSS class for the SVG element
  @param {number} [width] - SVG width in pixels
  @param {number} [height] - SVG height in pixels

  @example
  {% render 'icon', icon: 'tag' %}
  {% render 'icon', icon: 'cart', width: 20, height: 20 %}
  {% render 'icon', icon: 'edit', class: 'custom-edit-icon', width: 16, height: 16 %}
{% enddoc %}

{%- case icon -%}
  {%- when 'tag', 'discount' -%}
    <svg
      class="{{ class | default: 'icon-tag' }}"
      viewBox="0 0 24 24"
      width="{{ width | default: 14 }}"
      height="{{ height | default: 14 }}"
      stroke="currentColor"
      stroke-width="2"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
      <line x1="7" y1="7" x2="7.01" y2="7"></line>
    </svg>

  {%- when 'edit', 'pencil', 'note' -%}
