{% doc %}
  Renders the global slide-out cart drawer component with free shipping progress,
  dynamic quantity adjustments, order notes, and checkout actions.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

<cart-drawer
  id="CartDrawer"
  class="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.title' | t }}"
  aria-hidden="true"
  data-cart-type="{{ settings.cart_type | default: 'drawer' }}"
  data-free-shipping-goal="{{ settings.cart_free_shipping_threshold | default: 50 | times: 100 }}"
>
  {%- # Darkened background overlay -%}
  <div class="cart-drawer__overlay" data-cart-drawer-close aria-hidden="true"></div>

  {%- # Main Drawer Content Panel -%}
  <div class="cart-drawer__panel">
    {%- # Header -%}
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-title">
        <h2 class="cart-drawer__heading">{{ 'cart.title' | t }}</h2>
        <span class="cart-drawer__count-badge" data-cart-count>{{ cart.item_count }}</span>
      </div>
      <button
        type="button"
        class="cart-drawer__close-btn"
        data-cart-drawer-close
        aria-label="Close cart"
      >
        {% render 'icon', icon: 'close', width: 20, height: 20 %}
      </button>
    </div>

    {%- # Free Shipping Bar -%}
    {%- if settings.cart_show_free_shipping -%}
      {%- assign threshold_cents = settings.cart_free_shipping_threshold | default: 50 | times: 100 -%}
      {%- assign diff_cents = threshold_cents | minus: cart.total_price -%}
      <div
        class="cart-drawer__shipping-bar"
        data-shipping-bar
        data-threshold="{{ threshold_cents }}"
      >
        <div class="cart-drawer__shipping-message" data-shipping-message>
          {%- if cart.total_price >= threshold_cents and cart.item_count > 0 -%}
            {{ 'cart.free_shipping' | t }}: 🎉 You've unlocked Free Shipping!
          {%- elsif cart.item_count == 0 -%}
            Add {{ threshold_cents | money }} more to unlock Free Shipping!
          {%- else -%}
            Add {{ diff_cents | money }} more to unlock Free Shipping!
          {%- endif -%}
        </div>
        <div class="cart-drawer__shipping-track" aria-hidden="true">
          {%- assign progress_pct = cart.total_price | times: 100 | divided_by: threshold_cents -%}
          {%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}
          <div
            class="cart-drawer__shipping-progress"
            data-shipping-progress
            style="width: {{ progress_pct }}%;"
          ></div>
        </div>
      </div>
    {%- endif -%}

    {%- # Scrollable Body - Cart Items or Empty State -%}
    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- # Empty State -%}
      <div class="cart-drawer__empty {% if cart.item_count > 0 %}hidden{% endif %}" data-cart-empty>
        <div class="cart-drawer__empty-icon" aria-hidden="true">
          {% render 'icon', icon: 'bag', width: 48, height: 48 %}
        </div>
        <p class="cart-drawer__empty-heading">{{ 'cart.empty' | t }}</p>
        <p class="cart-drawer__empty-text">{{ 'cart.empty_subtext' | t }}</p>
        <a
          href="{{ routes.all_products_collection_url | default: '/collections/all' }}"
          class="btn cart-drawer__empty-btn"
          data-cart-drawer-close
        >
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>

      {%- # Active Cart Items List -%}
      <div class="cart-drawer__items {% if cart.item_count == 0 %}hidden{% endif %}" data-cart-items>
        {%- for item in cart.items -%}
          <div
            class="cart-drawer__item"
            data-cart-item
            data-item-key="{{ item.key }}"
            data-variant-id="{{ item.variant_id }}"
            data-line-index="{{ forloop.index }}"
          >
            <div class="cart-drawer__item-image-wrapper">
              {%- if item.image != blank -%}
                <img
                  src="{{ item.image | image_url: width: 180 }}"
                  alt="{{ item.title | escape }}"
                  class="cart-drawer__item-image"
                  width="90"
                  height="90"
                  loading="lazy"
                >
              {%- else -%}
                <div class="cart-drawer__item-image-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
            </div>

            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title">
                {{ item.product.title }}
              </a>

              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-drawer__item-options">
                  {%- for option in item.options_with_values -%}
                    <span class="cart-drawer__item-option">{{ option.name }}: {{ option.value }}</span>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

              {%- if item.selling_plan_allocation -%}
                <div class="cart-drawer__item-plan">
                  {{ item.selling_plan_allocation.selling_plan.name }}
                </div>
              {%- endif -%}

              {%- # Line item discounts -%}
              {%- if item.line_level_discount_allocations.size > 0 -%}
                <div class="cart-drawer__item-discounts">
                  {%- for discount in item.line_level_discount_allocations -%}
                    <span class="cart-drawer__discount-tag">
                      {% render 'icon', icon: 'tag' %}
                      <span>{{ discount.discount_application.title }} (-{{ discount.amount | money }})</span>
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="cart-drawer__item-price-row">
                <div class="cart-drawer__item-prices">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="cart-drawer__item-price-final">{{ item.final_line_price | money }}</span>
                    <s class="cart-drawer__item-price-original">{{ item.original_line_price | money }}</s>
                  {%- else -%}
                    <span class="cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>

                {%- # Quantity Adjuster & Remove -%}
                <div class="cart-drawer__item-actions">
                  <div class="cart-drawer__qty-stepper">
                    <button
                      type="button"
                      class="cart-drawer__qty-btn"
                      data-qty-action="decrease"
                      data-key="{{ item.key }}"
                      aria-label="Decrease quantity for {{ item.product.title | escape }}"
                    >
                      −
                    </button>
                    <input
                      type="number"
                      class="cart-drawer__qty-input"
                      value="{{ item.quantity }}"
                      min="0"
                      data-qty-input
                      data-key="{{ item.key }}"
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >
                    <button
                      type="button"
                      class="cart-drawer__qty-btn"
                      data-qty-action="increase"
                      data-key="{{ item.key }}"
                      aria-label="Increase quantity for {{ item.product.title | escape }}"
                    >
                      +
                    </button>
                  </div>

                  <button
                    type="button"
                    class="cart-drawer__remove-btn"
                    title="Remove"
                    data-remove-item
                    data-key="{{ item.key }}"
                    aria-label="{{ 'cart.remove' | t }}: {{ item.product.title | escape }}"
                  >
                    {% render 'icon', icon: 'trash', width: 16, height: 16 %}
                  </button>
                </div>
              </div>

              <div class="cart-drawer__item-error hidden" data-item-error role="alert">
                <span class="cart-drawer__error-icon" aria-hidden="true">
                  {% render 'icon', icon: 'warning', width: 14, height: 14 %}
                </span>
                <span class="cart-drawer__error-text" data-item-error-text></span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="cart-drawer__error-banner hidden" data-cart-error-banner role="alert">
        <span class="cart-drawer__error-icon" aria-hidden="true">
          {% render 'icon', icon: 'warning', width: 16, height: 16 %}
        </span>
        <span class="cart-drawer__error-text" data-cart-error-text></span>
      </div>
      <template id="cart-drawer-error-icon-template">
        <span class="cart-drawer__error-icon" aria-hidden="true">
          {% render 'icon', icon: 'warning', width: 14, height: 14 %}
        </span>
      </template>
    </div>

    {%- # Footer - Actions & Checkout -%}
    <div class="cart-drawer__footer {% if cart.item_count == 0 %}hidden{% endif %}" data-cart-footer>
      {%- # Order Note Snippet -%}
      {% render 'cart-note', context: 'drawer' %}

      {%- # Discount Code Snippet -%}
      {% render 'cart-discount', context: 'drawer' %}

      <div class="cart-drawer__summary-rows">
        <div class="cart-drawer__summary-row cart-drawer__summary-row--subtotal">
          <span class="cart-drawer__subtotal-label">{{ 'cart.subtotal' | t }}</span>
          <span class="cart-drawer__subtotal-amount" data-cart-subtotal>
            {{- cart.original_total_price | default: cart.total_price | money -}}
          </span>
        </div>

        <div
          class="cart-drawer__summary-row cart-drawer__summary-row--savings {% unless cart.total_discount > 0 %}hidden{% endunless %}"
          data-cart-savings-row
        >
          <span class="cart-drawer__savings-label">
            <span>{{ 'cart.savings' | t }}</span>
            <span class="cart-drawer__savings-code" data-cart-savings-code></span>
          </span>
          <span class="cart-drawer__savings-amount" data-cart-savings>-{{ cart.total_discount | money }}</span>
        </div>

        <div
          class="cart-drawer__summary-row cart-drawer__summary-row--total {% unless cart.total_discount > 0 %}hidden{% endunless %}"
          data-cart-total-row
        >
          <span class="cart-drawer__total-label">Total</span>
          <span class="cart-drawer__total-amount" data-cart-total>{{ cart.total_price | money }}</span>
        </div>
      </div>

      <p class="cart-drawer__disclaimer">
        {{ 'cart.taxes_and_shipping_at_checkout' | t }}
      </p>

      <div class="cart-drawer__actions">
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout-form">
          <input type="hidden" name="discount" value="" data-discount-hidden-input>
          <button
            type="submit"
            name="checkout"
            class="btn cart-drawer__btn cart-drawer__btn--checkout"
          >
            <span>{{ 'cart.checkout' | t }}</span>
            <span class="cart-drawer__checkout-dot">•</span>
            <span data-cart-checkout-subtotal>{{ cart.total_price | money }}</span>
          </button>
        </form>

        <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart-link">
          {{ 'cart.view_cart' | t }}
        </a>
      </div>
    </div>
  </div>
</cart-drawer>
