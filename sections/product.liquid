{% comment %}
  Product Page Section - CartPerksFlow Theme
  Renders the 2 core components:
  1. Product Media Gallery (`snippets/product-gallery.liquid`)
  2. Product Information (`snippets/product-info.liquid`)
{% endcomment %}

{{ 'product.css' | asset_url | stylesheet_tag }}
{{ 'product-gallery.css' | asset_url | stylesheet_tag }}
{{ 'product-info.css' | asset_url | stylesheet_tag }}
{{ 'swatches.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'swatches.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- assign current_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
{%- assign media_pos = section.settings.desktop_media_position | default: 'left' -%}
{%- assign gallery_layout = section.settings.gallery_desktop_layout | default: 'slider' -%}
{%- assign is_sticky_gallery = section.settings.enable_sticky_gallery | default: false -%}

<div class="product-section" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="product-section__container">
    <div class="product-layout product-layout--media-{{ media_pos }} product-layout--gallery-{{ gallery_layout }}{% if is_sticky_gallery %} product-layout--sticky-gallery{% endif %}">
      {%- # Component 1: Product Media Gallery -%}
      <div class="product-layout__gallery-col">
        {% render 'product-gallery',
          product: product,
          current_variant: current_variant,
          image_zoom: section.settings.enable_image_zoom,
          thumbnail_position: section.settings.thumbnail_position,
          aspect_ratio: section.settings.media_aspect_ratio,
          gallery_desktop_layout: gallery_layout
        %}
      </div>

      {%- # Component 2: Product Information -%}
      <div class="product-layout__info-col">
        {% render 'product-info',
          product: product,
          current_variant: current_variant,
          section_id: section.id,
          blocks: section.blocks
        %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "header",
      "content": "Media Gallery"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "Desktop media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "gallery_desktop_layout",
      "label": "Desktop gallery layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "columns_2",
          "label": "2 Columns"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_gallery",
      "label": "Enable sticky gallery on desktop",
      "default": false,
      "info": "Keeps the media gallery visible on screen while product information scrolls."
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Desktop thumbnail position (Slider)",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media aspect ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom & lightbox",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_sku",
          "label": "Show SKU",
          "default": false
        }
      ]
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix",
          "default": "SKU:"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_saving_badge",
          "label": "Show discount badge",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_shipping_notice",
          "label": "Show shipping notice",
          "default": true
        },
        {
          "type": "text",
          "id": "shipping_notice_text",
          "label": "Shipping notice text",
          "default": "Taxes included. Free shipping on orders over $50."
        }
      ]
    },
    {
      "type": "inventory_threshold",
      "name": "Inventory Threshold",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "threshold",
          "min": 1,
          "max": 30,
          "step": 1,
          "label": "Low stock threshold",
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_inventory_quantity",
          "label": "Show remaining item quantity",
          "default": true
        },
        {
          "type": "text",
          "id": "in_stock_text",
          "label": "In stock message",
          "default": "In stock, ready to dispatch today"
        },
        {
          "type": "text",
          "id": "low_stock_text",
          "label": "Low stock message",
          "default": "Low stock — only {quantity} left!"
        },
        {
          "type": "text",
          "id": "sold_out_text",
          "label": "Sold out message",
          "default": "Sold out — join waitlist"
        }
      ]
    },
    {
      "type": "variants",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Style",
          "options": [
            {
              "value": "swatches",
              "label": "Swatches"
            },
            {
              "value": "dropdown",
              "label": "Dropdown"
            }
          ],
          "default": "swatches"
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Quantity"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity_selector",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true,
          "info": "Displays branded accelerated checkout buttons like Shop Pay, PayPal, Apple Pay, etc."
        }
      ]
    },
    {
      "type": "trust_grid",
      "name": "Trust Grid",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Item 1"
        },
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Discount Tag" }
          ],
          "default": "package"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Heading",
          "default": "Free Express Delivery"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Description",
          "default": "Dispatched securely with tracking"
        },
        {
          "type": "header",
          "content": "Item 2"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Discount Tag" }
          ],
          "default": "return"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Heading",
          "default": "30-Day Easy Returns"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Description",
          "default": "Love it or return it for a refund"
        },
        {
          "type": "header",
          "content": "Item 3"
        },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Discount Tag" }
          ],
          "default": "lock"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Heading",
          "default": "Secure 256-Bit Checkout"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Description",
          "default": "Encrypted and guaranteed safe payment"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "collapse_content",
          "label": "Display in collapsible accordion tab",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Details"
        }
      ]
    },
    {
      "type": "share",
      "name": "Social Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Share label",
          "default": "Share:"
        },
        {
          "type": "checkbox",
